{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

go.lycupaynotion.top {
	reverse_proxy 127.0.0.1:8766
}

www.lycupaynotion.top {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# The editor is integrated into the portal; keep old bookmarks compatible.
	handle /editor {
		redir https://{http.request.host}/content-management 308
	}
	handle /editor/assets/* {
		respond 410
	}
	handle_path /editor/* {
		redir https://{http.request.host}/content-management{path} 308
	}

	# Uploaded images must pass through the Go API ownership/public-reference gate.
	handle /uploads/* {
		reverse_proxy 127.0.0.1:8082 {
			header_up X-Portal-Client-IP {client_ip}
		}
	}

	# Internal control surfaces are intentionally not reachable from the public gateway.
	handle /api/events {
		respond 404
	}
	handle /api/dbz {
		respond 404
	}
	handle /api/readyz {
		respond 404
	}
	handle /api/metrics {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8082 {
			header_up X-Portal-Client-IP {client_ip}
		}
	}

	handle {
		root * /opt/portal-static-assets/frontend/dist
		try_files {path} /index.html
		file_server
	}
}

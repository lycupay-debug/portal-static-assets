{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

www.lycupaynotion.top {
	# Legacy content URLs redirect under /api so the Path=/api session cookie is sent.
	handle /uploads/* {
		redir https://{http.request.host}/api{uri} 308
	}

	# Strip only the public API prefix; Go receives /uploads/<filename> for authorization.
	handle /api/uploads/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8081 {
			header_up X-Portal-Client-IP {client_ip}
		}
	}

	# Compatibility redirects: the editor is integrated into the main portal again.
	handle /editor {
		redir https://{http.request.host}/content-management 308
	}
	handle /editor/assets/* {
		respond 410
	}
	handle_path /editor/* {
		redir https://{http.request.host}/content-management{path} 308
	}

	# Internal control surfaces must never be exposed through the public gateway.
	handle /api/events {
		respond 404
	}
	handle /api/dbz {
		respond 404
	}
	handle /api/readyz {
		respond 404
	}
	handle /api/metrics {
		respond 404
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8081 {
			# Send Caddy's parsed client IP, derived only from trusted Cloudflare peers.
			header_up X-Portal-Client-IP {client_ip}
		}
	}

	handle {
		route {
			header {
				X-Content-Type-Options "nosniff"
				X-Frame-Options "DENY"
				Referrer-Policy "strict-origin-when-cross-origin"
				Permissions-Policy "camera=(), microphone=(), geolocation=()"
			}
			root * /usr/local/www/personal-portal/current
			encode zstd gzip
			try_files {path} /index.html
			@html path /index.html
			header @html Cache-Control "no-cache"
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}

go.lycupaynotion.top {
	reverse_proxy 127.0.0.1:8766
}

assets.lycupaynotion.top {
	@staticAssets path /assets/*
	handle @staticAssets {
		root * /usr/local/www/portal-static-assets/current/site
		header {
			Access-Control-Allow-Origin "https://www.lycupaynotion.top"
			Vary "Origin"
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}

	@staticIcons path /icons/*
	handle @staticIcons {
		root * /usr/local/www/portal-static-assets/current/site
		header {
			Access-Control-Allow-Origin "https://www.lycupaynotion.top"
			Vary "Origin"
			Cache-Control "public, max-age=86400"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}

	handle {
		respond 404
	}
}

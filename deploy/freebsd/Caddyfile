www.lycupaynotion.top {
	handle_path /uploads/* {
		root * /usr/local/www/personal-portal/uploads
		encode zstd gzip
		file_server
	}

	# Internal control surfaces must never be exposed through the public gateway.
	handle /api/events {
		respond 404
	}
	handle /api/dbz {
		respond 404
	}
	handle /api/readyz {
		respond 404
	}
	handle /api/metrics {
		respond 404
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		route {
			header {
				X-Content-Type-Options "nosniff"
				X-Frame-Options "DENY"
				Referrer-Policy "strict-origin-when-cross-origin"
				Permissions-Policy "camera=(), microphone=(), geolocation=()"
			}
			root * /usr/local/www/personal-portal/current
			encode zstd gzip
			try_files {path} /index.html
			@html path /index.html
			header @html Cache-Control "no-cache"
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}

free.lycupaynotion.top {
	reverse_proxy 127.0.0.1:8765
}

n8n.lycupaynotion.top {
	reverse_proxy 127.0.0.1:5678
}

{
  "name": "personal-portal-frontend",
  "version": "0.1.0",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test && npm run type-check && vite build && node scripts/check-bundle-budget.mjs",
    "test": "tsx --test test/*.test.ts",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "api:generate": "openapi-ts -f openapi-ts.config.mjs",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated",
    "api:lint": "redocly lint ../api/openapi.yaml",
    "check:static-assets": "node ../scripts/check-static-assets-layout.mjs dist",
    "package:static-assets": "node ../scripts/package-static-assets.mjs dist",
    "build:static-origin": "npm run type-check && vite build --base=https://assets.lycupaynotion.top/ --outDir dist-static-origin && node scripts/check-bundle-budget.mjs dist-static-origin && node ../scripts/check-static-origin-build.mjs dist-static-origin",
    "package:static-origin": "node ../scripts/package-static-origin.mjs dist-static-origin",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tiptap/extension-drag-handle": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bootstrap": "6.0.0-alpha.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "^2.64.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
